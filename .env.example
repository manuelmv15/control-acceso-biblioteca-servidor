# usuario del panel admin, obligatorio (ej: admin). Solo se usa una vez, para
# crear el primer administrador en la base de datos si no existe ninguno —
# después el admin cambia su contraseña desde el panel y este valor deja de
# importar (ver README, sección Seguridad).
ADMIN_USER=admin
# hash de la contraseña INICIAL del panel admin, obligatorio. NO es la
# contraseña en texto plano. El valor de acá abajo es solo un EJEMPLO de
# formato (hash de "cambiar-esta-contrasena", publicado en este mismo repo
# público) — el servidor lo reconoce y se niega a crear el admin inicial
# con él, así que dejarlo tal cual deja el panel sin
# ningún administrador. Generá tu propio hash con
# `python3 servidor/generar_hash_admin.py` (ejecutado en tu propia máquina,
# no en el servidor de despliegue, para que quien despliega no vea la
# contraseña real) y pegá acá el resultado.
ADMIN_PASS_HASH=pbkdf2_sha256$600000$deec2f9628d2aec504107990557ae826$716dc1a2a52dc2ce925fc7ca9a369d1d13ef57f23b4105c3e623a5af647e6289

DB_NAME=biblioteca
DB_USER=biblioteca
# cambia-esta-contrasena-de-db
DB_PASSWORD=
# cambia-esta-contrasena-de-root
MYSQL_ROOT_PASSWORD=

# openssl rand -hex 32, obligatoria
SECRET_KEY=

# openssl rand -hex 32 — compartida por todos los kioscos, distinta de SECRET_KEY
KIOSK_API_KEY=

# opcional, orígenes separados por coma (ej: https://panel.midominio.com) — vacío = sin acceso cross-origin (el panel se sirve desde el mismo origen que la API, así que no lo necesita por defecto)
CORS_ORIGINS=

# opcional, default 5 — intentos fallidos de /auth/login antes de bloquear temporalmente la IP
LOGIN_MAX_INTENTOS=
# opcional, default 15 — minutos de bloqueo tras exceder LOGIN_MAX_INTENTOS
LOGIN_BLOQUEO_MINUTOS=

# opcional, vacío por defecto — IPs separadas por coma de reverse proxies/túneles
# de confianza (ej: Cloudflare Tunnel) autorizados a fijar X-Forwarded-For con la
# IP real del cliente para el rate limiting de /auth/login. Dejar vacío si el
# servidor no está detrás de un proxy (si lo está y esto queda vacío, todas las
# conexiones legítimas comparten la IP del proxy y un solo atacante bloquea a
# todos los administradores).
TRUSTED_PROXIES=

# opcional, default 5000000 (5MB) — límite de tamaño de body para POST/PUT/PATCH en toda la API
MAX_BODY_SIZE_BYTES=
# opcional, default 500 — máximo de sesiones por lote en POST /sync
SYNC_MAX_SESIONES=
# opcional, default 30 — consultas por minuto y por IP a GET /estudiantes/{carnet}
# autenticadas con KIOSK_API_KEY (el panel admin, con JWT, no tiene este límite).
# Evita que quien tenga la key compartida de kiosko pueda barrer el espacio de
# carnets y extraer los datos de toda la población estudiantil.
ESTUDIANTES_MAX_LECTURAS_MIN=

# TLS entre los kioscos y este servidor (recomendado — sin esto, la PII de
# estudiantes y KIOSK_API_KEY viajan sin cifrar por la LAN, ver
# docs/desarrollo/despliegue.md sección TLS y servidor/scripts/generar_ca.sh).
# Rutas DENTRO del contenedor; docker-compose.prod.yml monta TLS_CERTS_DIR
# (host, default ./certs) en /certs. Dejar ambas vacías = HTTP plano.
TLS_CERT_PATH=
TLS_KEY_PATH=
# opcional, default ./certs — carpeta en el host con ca.key/ca.pem/server.key/server.pem
TLS_CERTS_DIR=
