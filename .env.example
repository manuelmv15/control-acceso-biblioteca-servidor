ADMIN_USER= #usuario del panel admin, obligatorio (ej: admin)
ADMIN_PASS= #contraseña del panel admin, obligatoria — cambia esto, ej: openssl rand -base64 24

DB_NAME=biblioteca
DB_USER=biblioteca
DB_PASSWORD= #cambia-esta-contrasena-de-db
MYSQL_ROOT_PASSWORD= #cambia-esta-contrasena-de-root

SECRET_KEY= #openssl rand -hex 32, obligatoria

KIOSK_API_KEY= #openssl rand -hex 32 — compartida por todos los kioscos, distinta de SECRET_KEY

CORS_ORIGINS= #opcional, orígenes separados por coma (ej: https://panel.midominio.com) — vacío = sin acceso cross-origin (el panel se sirve desde el mismo origen que la API, así que no lo necesita por defecto)
