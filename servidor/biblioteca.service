[Unit]
Description=Biblioteca Control — Servidor FastAPI
After=network.target

[Service]
Type=simple
User=biblioteca
WorkingDirectory=/opt/biblioteca/servidor
ExecStart=/opt/biblioteca/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=SECRET_KEY=CAMBIAR_EN_PRODUCCION
Environment=ADMIN_PASS=CAMBIAR_EN_PRODUCCION

[Install]
WantedBy=multi-user.target
